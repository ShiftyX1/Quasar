# Основные настройки приложения
BACKEND_PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1d
NODE_ENV=development

# База данных
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chat_db

# Keycloak SSO настройки
# Включение/отключение Keycloak
KEYCLOAK_ENABLED=false

# Режим работы аутентификации
# local-only: только локальная аутентификация (по умолчанию)
# hybrid: локальная + SSO аутентификация
# sso-only: только SSO аутентификация
KEYCLOAK_MODE=local-only

# Настройки Keycloak (обязательны только если KEYCLOAK_ENABLED=true)
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback

# Redis настройки (обязательны только если KEYCLOAK_ENABLED=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0 